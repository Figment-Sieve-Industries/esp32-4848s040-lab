.pio/
__pycache__/

# VS Code: share only extension recommendations
**/.vscode/*
!**/.vscode/extensions.json

# Firmware images are ignored everywhere (factory flash backups hold the board's MAC and vendor firmware,
# so they must never be committed). Only docs/ may hold .bin files.
*.bin
!docs/**/*.bin

# Per-project credentials (copy secrets.example.h -> secrets.h)
**/src/secrets.h

# Serial and soak logs (they contain the home SSID)
*.log

# Screenshot output of tools-dev/screendump.py (e.g. `screendump.py COM9 out --all`)
out/
out-*.png

# clang-tidy compilation database (tools/lint.ps1 moves it to %TEMP%; this is a safety net)
compile_commands.json

# Factory flash backups contain device identifiers (MAC) and vendor firmware: keep them local
firmware/factory/*.bin

# Claude Code agent worktrees
.claude/
