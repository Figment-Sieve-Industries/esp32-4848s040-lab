.pio/
__pycache__/

# VS Code: share only extension recommendations
**/.vscode/*
!**/.vscode/extensions.json

# Firmware images: ignored except docs and firmware/ (backups are committed on purpose)
*.bin
!docs/**/*.bin
!firmware/**/*.bin

# Per-project credentials (copy secrets.example.h -> secrets.h)
**/src/secrets.h

# Serial test logs (06-sd-card-test/sd_serial.py)
sd_serial_*.log

# clang-tidy compilation database (tools/lint.ps1 moves it to %TEMP%; this is a safety net)
compile_commands.json

# Factory flash backups contain device identifiers (MAC) and vendor firmware: keep them local
firmware/factory/*.bin

# Claude Code agent worktrees
.claude/
